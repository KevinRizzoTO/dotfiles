[gpg]
	format = ssh
[commit]
	gpgsign = true
[user]
	signingkey = /Users/kevinrizzo/.ssh/id_ed25519_github.pub
	email = contact@kevinrizzo.com
	name = Kevin Rizzo
[core]
	hooksPath = /Users/kevinrizzo/.config/git/hooks
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	syntax-theme = gruvbox-dark
	true-color = auto
[diff]
	tool = delta
[difftool]
	prompt = false
[pager]
	difftool = less -FRX
[difftool "delta"]
	cmd = delta "$LOCAL" "$REMOTE"
[git-town]
	sync-feature-strategy = rebase
	offline = false
[rerere]
	enabled = true
	autoupdate = true
[gpg "ssh"]
	allowedSignersFile = /Users/kevinrizzo/.ssh/allowed_signers

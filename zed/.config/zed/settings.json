// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "format_on_save": "on",
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^acli\\s+jira(\\s|$)",
            },
            {
              "pattern": "^PAGER=cat\\s+acli\\s+jira(\\s|$)",
            },
          ],
        },
      },
    },
    "sidebar_side": "right",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-terra",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "cursor_shape": "bar",
    "font_family": "MesloLGM Nerd Font",
    "default_height": 10000.0,
  },
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
      ],
    },
  },
}
